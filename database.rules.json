{
  "rules": {
    ".read": false,
    ".write": false,

    "dublin-hunt": {
      "game": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['started', 'mode', 'pin'])",
        "started": { ".validate": "newData.isBoolean()" },
        "mode": { ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'approval')" },
        "pin": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,6}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "$other": { ".validate": false }
      },

      "teams": {
        ".read": true,
        ".write": true,

        "$teamNum": {
          ".validate": "$teamNum.matches(/^([1-9]|1[0-2])$/) && newData.hasChildren(['joined', 'currentStep'])",
          "joined": { ".validate": "newData.isBoolean()" },
          "pendingApproval": { ".validate": "newData.isBoolean()" },
          "currentStep": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12 && (!data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 1))"
          },
          "startedAt": { ".validate": "newData.isNumber()" },
          "submittedAt": { ".validate": "newData.isNumber()" },
          "lastApproved": { ".validate": "newData.isNumber()" },
          "photos": {
            "$step": {
              ".validate": "$step.matches(/^([0-9]|1[01])$/)",
              "data": { ".validate": "newData.isString() && newData.val().length <= 1500000" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
